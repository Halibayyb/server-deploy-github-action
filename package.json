{
  "name": "express-bun-server",
  "version": "1.0.0",
  "description": "Express server with TypeScript and Bun",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec bun run src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "nodemon": "^3.1.14",
    "typescript": "^5.1.3"
  }
}
